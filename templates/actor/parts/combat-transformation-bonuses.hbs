{{!-- Per-transformation bonuses & activables: MP / EP / AF / LF (rendered in the Transformations tab) --}}
        {{#if hasManifestedPowers}}
        <div class="mp-entries">
          {{#each manifestedPowerBonuses.entries}}
          <div class="mp-entry">
            <div class="mp-entry-header">
              <span class="mp-name">{{this.name}}</span>
              <span class="mp-stacks">Z={{this.stacks}}</span>
            </div>
            {{#if this.bonuses.length}}
            <div class="mp-bonus-list bonus-cards-grid">
              {{#each this.bonuses}}
              <div class="bonus-card cat-utility">
                <div class="bonus-card-value" style="font-size:13px">{{this}}</div>
              </div>
              {{/each}}
            </div>
            {{/if}}
            {{#if this.conditionals.length}}
            <div class="mp-conditional-list bonus-cards-grid">
              {{#each this.conditionals}}
              <div class="bonus-card cat-conditional">
                <div class="bonus-card-value" style="font-size:12px">{{this}}</div>
              </div>
              {{/each}}
            </div>
            {{/if}}
            {{#if this.perRound.length}}
            <div class="mp-perround-list bonus-cards-grid">
              {{#each this.perRound}}
              <div class="bonus-card cat-perround">
                <div class="bonus-card-header"><i class="fas fa-sync-alt"></i></div>
                <div class="bonus-card-value" style="font-size:12px">{{this.label}}</div>
              </div>
              {{/each}}
            </div>
            {{/if}}
          </div>
          {{/each}}
        </div>

        {{!-- Per-Round Resources summary --}}
        {{#if mpPerRoundEffects.length}}
        <div class="mp-perround-panel">
          <div class="mp-perround-header">Per-Round Generation</div>
          {{#each mpPerRoundEffects}}
          <div class="mp-perround-item">
            <i class="fas fa-sync-alt"></i> {{label}} <small>({{sourceName}})</small>
          </div>
          {{/each}}
        </div>
        {{/if}}

        {{!-- Totals summary --}}
        <div class="mp-totals">
          <div class="mp-totals-header">Accumulated Totals</div>
          <div class="mp-totals-grid">
            {{#if manifestedPowerBonuses.totals.soak}}<span class="mp-total">Soak: {{manifestedPowerBonuses.totals.soak}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.defense}}<span class="mp-total">Defense: {{manifestedPowerBonuses.totals.defense}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.dr}}<span class="mp-total">DR: {{manifestedPowerBonuses.totals.dr}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.might}}<span class="mp-total">Might: {{manifestedPowerBonuses.totals.might}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.strike}}<span class="mp-total">Strike: {{manifestedPowerBonuses.totals.strike}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.dodge}}<span class="mp-total">Dodge: {{manifestedPowerBonuses.totals.dodge}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.wound}}<span class="mp-total">Wound: {{manifestedPowerBonuses.totals.wound}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.combatRolls}}<span class="mp-total">Combat Rolls: {{manifestedPowerBonuses.totals.combatRolls}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.lpMax}}<span class="mp-total">Max LP: {{manifestedPowerBonuses.totals.lpMax}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.kpMax}}<span class="mp-total">Max KP: {{manifestedPowerBonuses.totals.kpMax}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.capacityMax}}<span class="mp-total">Max Cap: {{manifestedPowerBonuses.totals.capacityMax}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.perception}}<span class="mp-total">Perception: {{manifestedPowerBonuses.totals.perception}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.intimidation}}<span class="mp-total">Intimidation: {{manifestedPowerBonuses.totals.intimidation}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.steadfast}}<span class="mp-total">Steadfast: +{{manifestedPowerBonuses.totals.steadfast}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.stressBonus}}<span class="mp-total">Stress: +{{manifestedPowerBonuses.totals.stressBonus}}</span>{{/if}}
            {{#if manifestedPowerBonuses.totals.allSaves}}<span class="mp-total">All Saves: {{manifestedPowerBonuses.totals.allSaves}}</span>{{/if}}
          </div>
        </div>
        {{else}}
        <div class="empty-message">No manifested powers active.</div>
        {{/if}}
        {{#if evilAuraActive}}
        <div class="evil-aura-panel">
          <div class="evil-aura-header">
            <i class="fas fa-skull"></i> Evil Aura
            <span class="evil-points">EP: <strong>{{evilPoints}}</strong></span>
          </div>
          <div class="evil-aura-controls">
            <button type="button" data-action="evil-aura-points-add"  class="action-btn"><i class="fas fa-plus"></i> +1 EP</button>
            <button type="button" data-action="evil-aura-points-sub"  class="action-btn"><i class="fas fa-minus"></i> -1 EP</button>
            {{#if evilTechsActive}}
              <button type="button" data-action="evil-aura-techs-deactivate" class="action-btn danger">
                <i class="fas fa-times"></i> Deactivate Evil Techniques
              </button>
              <span class="evil-techs-active-badge"><i class="fas fa-check"></i> Active until end of turn</span>
            {{else}}
              <button type="button" data-action="evil-aura-techs-activate" class="action-btn primary"
                      {{#if (lt evilPoints evilAuraTechniqueCost)}}disabled title="Need {{evilAuraTechniqueCost}} EP"{{/if}}>
                <i class="fas fa-bolt"></i> Activate Evil Techniques (-{{evilAuraTechniqueCost}} EP)
              </button>
            {{/if}}
          </div>
        </div>
        {{/if}}
        {{#if hasEnhancementPowers}}
