{{!-- Racial combat bonuses, trackers & activables (rendered in the Traits tab) --}}

      {{!-- ==================== CRUELTY TRACKER (Cruel Intentions) ==================== --}}
      {{> "systems/DBU-MRR-OLD/templates/actor/parts/cruelty-tracker.hbs"}}

      {{!-- ==================== BATTLE BORN TRACKER (Saiyan only) ==================== --}}
      {{#if isSaiyan}}
      <div class="battle-born-tracker">
        <div class="bb-header">
          <i class="fas fa-fist-raised"></i> Battle Born Tracker
          <span class="bb-total">Total: {{system.battleBorn.total}}/{{system.battleBorn.maxTotal}}</span>
          <label class="bb-undying-toggle">
            <input type="checkbox" name="system.battleBorn.undying" {{#if system.battleBorn.undying}}checked{{/if}} />
            Undying L3 (max 3)
          </label>
        </div>
        <div class="bb-allocations">
          <div class="bb-row" data-bb-type="strike">
            <span class="bb-label">Strike</span>
            <button type="button" class="bb-decrement" data-bb-type="strike" {{#if (eq system.battleBorn.strike 0)}}disabled{{/if}}><i class="fas fa-minus"></i></button>
            <div class="bb-pips">
              {{#each bbStrikePips}}<span class="bb-pip {{#if filled}}filled{{/if}}"></span>{{/each}}
            </div>
            <button type="button" class="bb-increment" data-bb-type="strike" {{#if (gte system.battleBorn.strike system.battleBorn.cap)}}disabled{{/if}}><i class="fas fa-plus"></i></button>
            <span class="bb-bonus">+{{system.battleBorn.strikeBonus}}</span>
          </div>
          <div class="bb-row" data-bb-type="dodge">
            <span class="bb-label">Dodge</span>
            <button type="button" class="bb-decrement" data-bb-type="dodge" {{#if (eq system.battleBorn.dodge 0)}}disabled{{/if}}><i class="fas fa-minus"></i></button>
            <div class="bb-pips">
              {{#each bbDodgePips}}<span class="bb-pip {{#if filled}}filled{{/if}}"></span>{{/each}}
            </div>
            <button type="button" class="bb-increment" data-bb-type="dodge" {{#if (gte system.battleBorn.dodge system.battleBorn.cap)}}disabled{{/if}}><i class="fas fa-plus"></i></button>
            <span class="bb-bonus">+{{system.battleBorn.dodgeBonus}}</span>
          </div>
          <div class="bb-row" data-bb-type="wound">
            <span class="bb-label">Wound</span>
            <button type="button" class="bb-decrement" data-bb-type="wound" {{#if (eq system.battleBorn.wound 0)}}disabled{{/if}}><i class="fas fa-minus"></i></button>
            <div class="bb-pips">
              {{#each bbWoundPips}}<span class="bb-pip {{#if filled}}filled{{/if}}"></span>{{/each}}
            </div>
            <button type="button" class="bb-increment" data-bb-type="wound" {{#if (gte system.battleBorn.wound system.battleBorn.cap)}}disabled{{/if}}><i class="fas fa-plus"></i></button>
            <span class="bb-bonus">+{{system.battleBorn.woundBonus}}</span>
          </div>
        </div>

        {{!-- Derived Bonuses --}}
        {{#if hasRacialBonuses}}
        <div class="bb-derived">
          <div class="bonus-cards-grid">
            {{#if racialBonuses.has.primitiveDurability}}
            <div class="bonus-card cat-armor" title="Primitive Durability (Battle Born)">
              <div class="bonus-card-header"><i class="fas fa-shield-alt"></i> Primitive Dur.</div>
              <div class="bonus-card-value">+{{racialBonuses.primitiveDurabilitySoak}}</div>
              <div class="bonus-card-stat">Soak</div>
            </div>
            {{/if}}
            {{#if racialBonuses.has.greaterPotential}}
            <div class="bonus-card cat-offense" title="Greater Potential (Battle Born)">
              <div class="bonus-card-header"><i class="fas fa-fire"></i> Greater Pot.</div>
              <div class="bonus-card-value">+{{racialBonuses.greaterPotentialWound}}</div>
              <div class="bonus-card-stat">Wound</div>
              {{#if (eq racialBonuses.greaterPotentialWound 0)}}<div class="bonus-card-note">need 4+ stacks</div>{{/if}}
            </div>
            {{/if}}
            {{#if racialBonuses.has.powerfulPhysique}}
            <div class="bonus-card cat-armor" title="Powerful Physique (Battle Born)">
              <div class="bonus-card-header"><i class="fas fa-dumbbell"></i> Powerful Phys.</div>
              <div class="bonus-card-value">+{{racialBonuses.powerfulPhysiqueSoak}}</div>
              <div class="bonus-card-stat">Soak</div>
            </div>
            {{/if}}
            {{#if racialBonuses.has.warriorsPride}}
            <div class="bonus-card cat-saves" title="Warrior's Pride (Battle Born)">
              <div class="bonus-card-header"><i class="fas fa-crown"></i> Warrior's Pride</div>
              <div class="bonus-card-value">+{{racialBonuses.warriorsPrideBonus}}</div>
              <div class="bonus-card-stat">Cognitive Save</div>
            </div>
            {{/if}}
          </div>
        </div>
        {{/if}}
      </div>
      {{/if}}

      {{!-- ==================== EARTHLING TRACKER (Earthling only) ==================== --}}
      {{#if isEarthling}}
      <div class="earthling-tracker">
        <div class="earthling-header">
          <i class="fas fa-user-shield"></i> Earthling Traits
        </div>

        {{!-- Experienced Fighter Mode Selector --}}
        {{#if earthlingBonuses.has.experiencedFighter}}
        <div class="ef-section">
          <div class="ef-label">
            Experienced Fighter
            <span class="ef-cost">Cost: {{earthlingBonuses.efKiCost}} Ki</span>
            {{#if efUsedThisRound}}<span class="ef-lock"><i class="fas fa-lock"></i> Used</span>{{/if}}
          </div>
          <div class="ef-modes">
            <button type="button" class="ef-mode-btn {{#if (eq efMode 'strike')}}active{{/if}}"
              data-action="ef-activate" data-ef-mode="strike"
              {{#unless efCanActivate}}{{#unless (eq efMode 'strike')}}disabled{{/unless}}{{/unless}}>
              <i class="fas fa-crosshairs"></i> Strike +{{earthlingBonuses.efStrikeBonus}}
            </button>
            <button type="button" class="ef-mode-btn {{#if (eq efMode 'dodge')}}active{{/if}}"
              data-action="ef-activate" data-ef-mode="dodge"
              {{#unless efCanActivate}}{{#unless (eq efMode 'dodge')}}disabled{{/unless}}{{/unless}}>
              <i class="fas fa-running"></i> Dodge +{{earthlingBonuses.efDodgeBonus}}
            </button>
            <button type="button" class="ef-mode-btn {{#if (eq efMode 'wound')}}active{{/if}}"
              data-action="ef-activate" data-ef-mode="wound"
              {{#unless efCanActivate}}{{#unless (eq efMode 'wound')}}disabled{{/unless}}{{/unless}}>
              <i class="fas fa-skull-crossbones"></i> Wound +{{earthlingBonuses.efWoundBonus}} / DC+{{earthlingBonuses.efDamageCategoryBonus}}
            </button>
            {{#unless (eq efMode 'none')}}
            <button type="button" class="ef-mode-btn ef-deactivate" data-action="ef-deactivate">
              <i class="fas fa-times"></i> Off
            </button>
            {{/unless}}
          </div>
        </div>
        {{/if}}

        {{!-- Derived Bonuses Display --}}
        {{#if hasEarthlingBonuses}}
        <div class="earthling-derived">
          <span class="earthling-derived-label">Active Bonuses ({{earthlingBonuses.thresholdsBelow}} threshold{{#if (gt earthlingBonuses.thresholdsBelow 1)}}s{{/if}} below):</span>
          <div class="bonus-cards-grid">
          {{#if earthlingBonuses.has.earthlingResolve}}
            <div class="bonus-card cat-offense" title="Earthling Resolve">
              <div class="bonus-card-header"><i class="fas fa-fist-raised"></i> Earthling Resolve</div>
              <div class="bonus-card-value">+{{earthlingBonuses.earthlingResolveStrike}}/+{{earthlingBonuses.earthlingResolveWound}}</div>
              <div class="bonus-card-stat">Strike / Wound</div>
            </div>
          {{/if}}
          {{#if earthlingBonuses.has.threeEyes}}
            <div class="bonus-card cat-offense" title="Three-Eyes">
              <div class="bonus-card-header"><i class="fas fa-eye"></i> Three-Eyes</div>
              <div class="bonus-card-value">+{{earthlingBonuses.threeEyesWound}}</div>
              <div class="bonus-card-stat">Wound (Sig. Tech)</div>
            </div>
          {{/if}}
          {{#if earthlingBonuses.has.partBeast}}
            <div class="bonus-card cat-utility" title="Part Beast">
              <div class="bonus-card-header"><i class="fas fa-eye"></i> Part Beast</div>
              <div class="bonus-card-value">+{{earthlingBonuses.partBeastPerception}}</div>
              <div class="bonus-card-stat">Perception</div>
            </div>
          {{/if}}
          </div>
        </div>
        {{/if}}
      </div>
      {{/if}}

      {{!-- ==================== MAJIN TRACKER (Majin only) ==================== --}}
      {{#if isMajin}}
      <div class="majin-tracker">
        <div class="majin-header">
          <i class="fas fa-ghost"></i> Majin Traits
        </div>

        {{#if hasMajinBonuses}}
        <div class="majin-derived">
          <div class="bonus-cards-grid">
          {{#if majinBonuses.has.rubberyBody}}
            <div class="bonus-card cat-armor" title="Bouncy (Rubbery Body)">
              <div class="bonus-card-header"><i class="fas fa-shield-alt"></i> Bouncy</div>
              <div class="bonus-card-value">+{{majinBonuses.bouncySoak}}/+{{majinBonuses.bouncyDefense}}</div>
              <div class="bonus-card-stat">Soak / Defense</div>
            </div>
            <div class="bonus-card cat-offense" title="Bouncy Vulnerability">
              <div class="bonus-card-header"><i class="fas fa-skull-crossbones"></i> Vulnerability</div>
              <div class="bonus-card-value">+{{majinBonuses.bouncyDirectVulnerability}}</div>
              <div class="bonus-card-stat">Dmg from Direct+</div>
            </div>
          {{/if}}
          {{#if majinBonuses.has.assimilation}}
            <div class="bonus-card cat-saves" title="Assimilation">
              <div class="bonus-card-header"><i class="fas fa-brain"></i> Assimilation</div>
              <div class="bonus-card-value">+{{majinBonuses.assimilationCorporeal}}</div>
              <div class="bonus-card-stat">Corporeal Save</div>
            </div>
          {{/if}}
          {{#if majinBonuses.has.bouncyPhysique}}
            <div class="bonus-card cat-offense" title="Bouncy Physique">
              <div class="bonus-card-header"><i class="fas fa-fist-raised"></i> Bouncy Phys.</div>
              <div class="bonus-card-value">+{{majinBonuses.bouncyPhysiqueStrike}}</div>
              <div class="bonus-card-stat">Strike (Reflect)</div>
            </div>
          {{/if}}
          {{#if majinBonuses.has.superRegeneration}}
            <div class="bonus-card cat-ki" title="Super Regeneration">
              <div class="bonus-card-header"><i class="fas fa-heart"></i> Super Regen</div>
              <div class="bonus-card-value">+{{majinBonuses.superRegenSurgency}}/+{{majinBonuses.superRegenLP}}</div>
              <div class="bonus-card-stat">Surgency / LP/rnd</div>
            </div>
          {{/if}}
          {{#if majinBonuses.has.majinMassShift}}
            <div class="bonus-card cat-utility" title="Mass-Shift">
              <div class="bonus-card-header"><i class="fas fa-brain"></i> Mass-Shift</div>
              <div class="bonus-card-value">+{{majinBonuses.massShiftSkillBonus}}</div>
              <div class="bonus-card-stat">Bluff/Pers/Intim</div>
            </div>
            {{#if (eq majinBonuses.massShiftSizeEffect "soak")}}
            <div class="bonus-card cat-armor" title="Mass-Shift (Small)">
              <div class="bonus-card-header"><i class="fas fa-shield-alt"></i> M-Shift (S)</div>
              <div class="bonus-card-value">+{{majinBonuses.massShiftSizeBonus}}</div>
              <div class="bonus-card-stat">Soak</div>
            </div>
            {{/if}}
            {{#if (eq majinBonuses.massShiftSizeEffect "kiReduction")}}
            <div class="bonus-card cat-ki" title="Mass-Shift (Medium)">
              <div class="bonus-card-header"><i class="fas fa-bolt"></i> M-Shift (M)</div>
              <div class="bonus-card-value">-{{majinBonuses.massShiftSizeBonus}}</div>
              <div class="bonus-card-stat">UA Ki Cost</div>
            </div>
            {{/if}}
            {{#if (eq majinBonuses.massShiftSizeEffect "defense")}}
            <div class="bonus-card cat-armor" title="Mass-Shift (Large+)">
              <div class="bonus-card-header"><i class="fas fa-shield-alt"></i> M-Shift (L+)</div>
              <div class="bonus-card-value">+{{majinBonuses.massShiftSizeBonus}}</div>
              <div class="bonus-card-stat">Defense</div>
            </div>
            {{/if}}
          {{/if}}
          {{#if majinBonuses.has.transfigurationBeam}}
            <div class="bonus-card cat-utility" title="Transfiguration Beam">
              <div class="bonus-card-header"><i class="fas fa-eye"></i> Transfig. Beam</div>
              <div class="bonus-card-value">-{{majinBonuses.transfigCritReduction}}</div>
              <div class="bonus-card-stat">Crit (Energy/Magic)</div>
            </div>
          {{/if}}
          {{#if majinBonuses.has.roomyBiology}}
            <div class="bonus-card cat-ki" title="Roomy Biology">
              <div class="bonus-card-header"><i class="fas fa-heart"></i> Roomy Biology</div>
              <div class="bonus-card-value">+{{majinBonuses.roomyBiologyLifeMod}}</div>
              <div class="bonus-card-stat">Life Modifier</div>
            </div>
          {{/if}}
          </div>
        </div>
        {{/if}}
      </div>
      {{/if}}

      {{!-- ==================== BIO-ANDROID TRACKER (Bio-Android only) ==================== --}}
      {{#if isBioAndroid}}
      <div class="bio-android-tracker">
        <div class="bio-android-header">
          <i class="fas fa-dna"></i> Bio-Android Traits
        </div>

        {{!-- Genetic Splicing Option Selector --}}
        {{#if bioAndroidBonuses.has.geneticSplicing}}
        <div class="racial-option-row">
          <label class="racial-option-label">Genetic Splicing:</label>
          <select name="system.geneticSplicingOption" class="racial-option-select">
            <option value="none" {{#if (eq bioAndroidBonuses.splicingOption "none")}}selected{{/if}}>-- Select --</option>
            <option value="resilience" {{#if (eq bioAndroidBonuses.splicingOption "resilience")}}selected{{/if}}>Genetic Resilience (+2 Life Mod)</option>
            <option value="genius" {{#if (eq bioAndroidBonuses.splicingOption "genius")}}selected{{/if}}>Genetic Genius (-1 Crit Skill Checks)</option>
            <option value="perfection" {{#if (eq bioAndroidBonuses.splicingOption "perfection")}}selected{{/if}}>Pursuit of Perfection (Absorption)</option>
          </select>
        </div>
        {{/if}}

        {{#if hasBioAndroidBonuses}}
        <div class="bio-android-derived">
          <div class="bonus-cards-grid">
          {{#if (eq bioAndroidBonuses.splicingOption "resilience")}}
            <div class="bonus-card cat-ki" title="Genetic Resilience">
              <div class="bonus-card-header"><i class="fas fa-heart"></i> Gen. Resilience</div>
              <div class="bonus-card-value">+{{bioAndroidBonuses.geneticResilienceLifeMod}}</div>
              <div class="bonus-card-stat">Life Modifier</div>
            </div>
          {{/if}}
          {{#if (eq bioAndroidBonuses.splicingOption "genius")}}
            <div class="bonus-card cat-utility" title="Genetic Genius">
              <div class="bonus-card-header"><i class="fas fa-eye"></i> Gen. Genius</div>
              <div class="bonus-card-value">-{{bioAndroidBonuses.geneticGeniusCritReduction}}</div>
              <div class="bonus-card-stat">Crit (Skill Checks)</div>
            </div>
          {{/if}}
          {{#if bioAndroidBonuses.has.powerCore}}
            <div class="bonus-card cat-ki" title="Power Core">
              <div class="bonus-card-header"><i class="fas fa-bolt"></i> Power Core</div>
              <div class="bonus-card-value">+{{bioAndroidBonuses.powerCoreSurgeBonus}}/+{{bioAndroidBonuses.powerCoreKiPerRound}}</div>
              <div class="bonus-card-stat">Surge Ki / Ki/rnd</div>
            </div>
          {{/if}}
          {{#if bioAndroidBonuses.has.redEye}}
            <div class="bonus-card cat-utility" title="Red Eye">
              <div class="bonus-card-header"><i class="fas fa-eye"></i> Red Eye</div>
              <div class="bonus-card-value">+{{bioAndroidBonuses.redEyePerception}}/-{{bioAndroidBonuses.redEyeCritReduction}}</div>
              <div class="bonus-card-stat">Percep / Crit (Sig)</div>
            </div>
          {{/if}}
          {{#if bioAndroidBonuses.has.namekianCells}}
            <div class="bonus-card cat-ki" title="Namekian Cells">
              <div class="bonus-card-header"><i class="fas fa-heart"></i> Namekian Cells</div>
              <div class="bonus-card-value">+{{bioAndroidBonuses.namekianCellsLP}}</div>
              <div class="bonus-card-stat">LP/round</div>
            </div>
          {{/if}}
          {{#if bioAndroidBonuses.has.geneticEfficiency}}
            <div class="bonus-card cat-offense" title="Genetic Efficiency">
              <div class="bonus-card-header"><i class="fas fa-skull-crossbones"></i> Gen. Efficiency</div>
              <div class="bonus-card-value">+{{bioAndroidBonuses.geneticEfficiencyWound}}</div>
              <div class="bonus-card-stat">Wound Rolls</div>
            </div>
          {{/if}}
          {{#if bioAndroidBonuses.has.geneticModification}}
            <div class="bonus-card cat-utility" title="Genetic Modification">
              <div class="bonus-card-header"><i class="fas fa-brain"></i> Gen. Modification</div>
              <div class="bonus-card-value">+{{bioAndroidBonuses.geneticModIntimidation}}</div>
              <div class="bonus-card-stat">Intimidation</div>
            </div>
          {{/if}}
          </div>
        </div>
        {{/if}}
      </div>
      {{/if}}

      {{!-- ==================== ANDROID TRACKER (Android only) ==================== --}}
      {{#if isAndroid}}
      <div class="android-tracker">
        <div class="android-header">
          <i class="fas fa-robot"></i> Android Traits
        </div>

        {{!-- Option Selectors --}}
        {{#if androidBonuses.has.wondersOfTechnology}}
        <div class="racial-option-row">
          <label class="racial-option-label">Wonders of Tech:</label>
          <select name="system.wondersOption" class="racial-option-select">
            <option value="none" {{#if (eq androidBonuses.wondersOpt "none")}}selected{{/if}}>-- Select --</option>
            <option value="enhancedOrganism" {{#if (eq androidBonuses.wondersOpt "enhancedOrganism")}}selected{{/if}}>Enhanced Organism</option>
            <option value="construct" {{#if (eq androidBonuses.wondersOpt "construct")}}selected{{/if}}>Construct</option>
            <option value="zombie" {{#if (eq androidBonuses.wondersOpt "zombie")}}selected{{/if}}>Zombie</option>
            <option value="machineMutant" {{#if (eq androidBonuses.wondersOpt "machineMutant")}}selected{{/if}}>Machine Mutant (+{{androidBonuses.wondersMachineMutantCorporeal}} Corp Save)</option>
          </select>
        </div>
        {{/if}}
        {{#if androidBonuses.has.energyCore}}
        <div class="racial-option-row">
          <label class="racial-option-label">Energy Core:</label>
          <select name="system.energyCoreOption" class="racial-option-select">
            <option value="none" {{#if (eq androidBonuses.energyCoreOpt "none")}}selected{{/if}}>-- Select --</option>
            <option value="infiniteEnergy" {{#if (eq androidBonuses.energyCoreOpt "infiniteEnergy")}}selected{{/if}}>Infinite Energy (+{{androidBonuses.energyCoreKiPerRound}} Ki/round)</option>
            <option value="powerBattery" {{#if (eq androidBonuses.energyCoreOpt "powerBattery")}}selected{{/if}}>Power Battery (2x Ki, -{{androidBonuses.powerBatteryKiReduction}} Ki cost)</option>
            <option value="mutantCore" {{#if (eq androidBonuses.energyCoreOpt "mutantCore")}}selected{{/if}}>Mutant Core (Integrate items)</option>
          </select>
        </div>
        {{/if}}
        {{#if androidBonuses.has.specializedFeatures}}
        <div class="racial-option-row">
          <label class="racial-option-label">Specialized:</label>
          <select name="system.specializedOption" class="racial-option-select">
            <option value="none" {{#if (eq androidBonuses.specializedOpt "none")}}selected{{/if}}>-- Select --</option>
            <option value="surgingPower" {{#if (eq androidBonuses.specializedOpt "surgingPower")}}selected{{/if}}>Surging Power</option>
            <option value="weaponPorts" {{#if (eq androidBonuses.specializedOpt "weaponPorts")}}selected{{/if}}>Weapon Ports</option>
            <option value="powerAbsorption" {{#if (eq androidBonuses.specializedOpt "powerAbsorption")}}selected{{/if}}>Power Absorption</option>
            <option value="hyperResilience" {{#if (eq androidBonuses.specializedOpt "hyperResilience")}}selected{{/if}}>Hyper Resilience</option>
            <option value="enhancedReflexes" {{#if (eq androidBonuses.specializedOpt "enhancedReflexes")}}selected{{/if}}>Enhanced Reflexes</option>
            <option value="heroicStyle" {{#if (eq androidBonuses.specializedOpt "heroicStyle")}}selected{{/if}}>Heroic Style</option>
            <option value="smallScale" {{#if (eq androidBonuses.specializedOpt "smallScale")}}selected{{/if}}>Small Scale Structure</option>
            <option value="largeScale" {{#if (eq androidBonuses.specializedOpt "largeScale")}}selected{{/if}}>Large Scale Structure</option>
            <option value="androidFusion" {{#if (eq androidBonuses.specializedOpt "androidFusion")}}selected{{/if}}>Android Fusion</option>
            <option value="extensionFeature" {{#if (eq androidBonuses.specializedOpt "extensionFeature")}}selected{{/if}}>Extension Feature</option>
          </select>
        </div>
        {{/if}}
        {{#if androidBonuses.has.functionalPurpose}}
        <div class="racial-option-row">
          <label class="racial-option-label">Func. Purpose:</label>
          <select name="system.functionalPurposeOption" class="racial-option-select">
            <option value="none" {{#if (eq androidBonuses.functionalOpt "none")}}selected{{/if}}>-- Select --</option>
            <option value="destroyer" {{#if (eq androidBonuses.functionalOpt "destroyer")}}selected{{/if}}>Destroyer</option>
            <option value="protector" {{#if (eq androidBonuses.functionalOpt "protector")}}selected{{/if}}>Protector</option>
            <option value="companion" {{#if (eq androidBonuses.functionalOpt "companion")}}selected{{/if}}>Companion</option>
            <option value="researcher" {{#if (eq androidBonuses.functionalOpt "researcher")}}selected{{/if}}>Researcher</option>
            <option value="leader" {{#if (eq androidBonuses.functionalOpt "leader")}}selected{{/if}}>Leader</option>
          </select>
        </div>
        {{/if}}

        {{#if hasAndroidBonuses}}
        <div class="android-derived">
          <div class="bonus-cards-grid">
          {{#if androidBonuses.has.damageInhibitor}}
            <div class="bonus-card cat-armor" title="Damage Inhibitor">
              <div class="bonus-card-header"><i class="fas fa-shield-alt"></i> Dmg Inhibitor</div>
              <div class="bonus-card-value">+{{androidBonuses.damageInhibitorDR}}</div>
              <div class="bonus-card-stat">DR, halve Collision</div>
            </div>
          {{/if}}
          {{#if androidBonuses.has.lockOn}}
            <div class="bonus-card cat-utility" title="Lock On">
              <div class="bonus-card-header"><i class="fas fa-eye"></i> Lock On</div>
              <div class="bonus-card-value">+{{androidBonuses.lockOnPerception}}</div>
              <div class="bonus-card-stat">Perception</div>
            </div>
          {{/if}}
          {{#if androidBonuses.has.energyCore}}
            <div class="bonus-card cat-ki" title="Energy Core">
              <div class="bonus-card-header"><i class="fas fa-bolt"></i> Energy Core</div>
              <div class="bonus-card-value" style="font-size:12px">Ki can't be reduced</div>
            </div>
          {{/if}}
          {{!-- Dynamic bonuses from options --}}
          {{#if (gt androidBonuses.wondersMachineMutantCorporeal 0)}}
            <div class="bonus-card cat-saves" title="Machine Mutant">
              <div class="bonus-card-header"><i class="fas fa-brain"></i> Machine Mutant</div>
