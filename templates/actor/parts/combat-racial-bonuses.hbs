          {{#if (gt shinjinBonuses.lightMagicKiReduction 0)}}
            <div class="bonus-card cat-ki" title="God of Magic">
              <div class="bonus-card-header"><i class="fas fa-bolt"></i> God of Magic</div>
              <div class="bonus-card-value">-{{shinjinBonuses.lightMagicKiReduction}}</div>
              <div class="bonus-card-stat">Ki (Magical UA)</div>
            </div>
          {{/if}}
          {{#if (gt shinjinBonuses.darkPowerfulSoak 0)}}
            <div class="bonus-card cat-armor" title="Powerful Demon">
              <div class="bonus-card-header"><i class="fas fa-shield-alt"></i> Powerful Demon</div>
              <div class="bonus-card-value">+{{shinjinBonuses.darkPowerfulSoak}}</div>
              <div class="bonus-card-stat">Soak</div>
            </div>
          {{/if}}
          {{#if (gt shinjinBonuses.darkEternalWound 0)}}
            <div class="bonus-card cat-offense" title="Eternal Demon">
              <div class="bonus-card-header"><i class="fas fa-skull-crossbones"></i> Eternal Demon</div>
              <div class="bonus-card-value">+{{shinjinBonuses.darkEternalWound}}</div>
              <div class="bonus-card-stat">Wound</div>
            </div>
          {{/if}}
          {{#if (gt shinjinBonuses.darkManipulativeCombat 0)}}
            <div class="bonus-card cat-offense" title="Manipulative Demon">
              <div class="bonus-card-header"><i class="fas fa-fist-raised"></i> Manipulative</div>
              <div class="bonus-card-value">+{{shinjinBonuses.darkManipulativeCombat}}</div>
              <div class="bonus-card-stat">Combat Rolls</div>
            </div>
          {{/if}}
          {{#if (gt shinjinBonuses.darkCommandingMinion 0)}}
            <div class="bonus-card cat-utility" title="Commanding Demon">
              <div class="bonus-card-header"><i class="fas fa-crown"></i> Commanding</div>
