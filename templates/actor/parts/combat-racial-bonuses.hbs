              <div class="bonus-card-value">-{{shinjinBonuses.arcaneCritReduction}}</div>
              <div class="bonus-card-stat">Crit Perception</div>
            </div>
          {{/if}}
          {{#if (gt shinjinBonuses.lightPeaceMoraleSave 0)}}
