            <option value="manipulative" {{#if (eq shinjinBonuses.darkOpt "manipulative")}}selected{{/if}}>Manipulative Demon (+Combat if SC/PE)</option>
            <option value="transforming" {{#if (eq shinjinBonuses.darkOpt "transforming")}}selected{{/if}}>Transforming Demon (+Stress Test)</option>
            <option value="elemental" {{#if (eq shinjinBonuses.darkOpt "elemental")}}selected{{/if}}>Elemental Demon (Profile bonus)</option>
            <option value="commanding" {{#if (eq shinjinBonuses.darkOpt "commanding")}}selected{{/if}}>Commanding Demon (+Minion Combat)</option>
