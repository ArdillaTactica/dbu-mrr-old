            <option value="judgment" {{#if (eq shinjinBonuses.lightOpt "judgment")}}selected{{/if}}>God of Judgment (Halve Aura Ki)</option>
            <option value="power" {{#if (eq shinjinBonuses.lightOpt "power")}}selected{{/if}}>God of Power (+Dodge if FO>AG)</option>
            <option value="speed" {{#if (eq shinjinBonuses.lightOpt "speed")}}selected{{/if}}>God of Speed (+Wound if AG>FO/MA)</option>
            <option value="war" {{#if (eq shinjinBonuses.lightOpt "war")}}selected{{/if}}>God of War (+Wound Armed)</option>
            <option value="magic" {{#if (eq shinjinBonuses.lightOpt "magic")}}selected{{/if}}>God of Magic (-Ki Magical UA)</option>
            <option value="time" {{#if (eq shinjinBonuses.lightOpt "time")}}selected{{/if}}>God of Time (Time Freeze)</option>
          </select>
        </div>
        {{/if}}

        {{!-- Dark Magic Option (Makaio) --}}
